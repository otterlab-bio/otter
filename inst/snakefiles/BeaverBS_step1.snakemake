#configfile: "config/config.yaml"

SIDs = config["SIDs"]
species = config["species"]
# 运行所有流程时，rule all 需要加入所有的output汇总
rule all:
  input:
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R1_fastqcx", "fastqc_data.txt"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R2_fastqcx", "fastqc_data.txt"), sample=SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_val_1.fq.gz"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_val_2.fq.gz"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_R1.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_R2.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_1_fastqcx", "fastqc_data.txt"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_2_fastqcx", "fastqc_data.txt"), sample=SIDs)


# 第一次QC
include: "rules/01fastqcxAtfirst.smk"

# Trim
include: "rules/02fastq2trim.smk"

# 第二次QC
include: "rules/03-0-fastqcxAtclean.smk"
