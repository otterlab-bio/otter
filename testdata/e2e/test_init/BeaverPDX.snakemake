#configfile: "config/config.yaml"

SIDs = config["SIDs"]
species = config["species"]
# 运行所有流程时，rule all 需要加入所有的output汇总
rule all:
  input:
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R1_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R2_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R1_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["before"], "{sample}_R2_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_val_1.fq.gz"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_val_2.fq.gz"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_R1.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["output"]["trim_dir"], "{sample}_R2.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_1_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_2_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_1_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["after"], "{sample}_val_2_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["directories"]["qc"]["main"], "{sample}_seqkit_stat.txt"), sample=SIDs) ,
    expand(os.path.join(config["directories"]["bsmap"]["main"], "{sample}_{species}.bam"), sample=SIDs,species = species) ,
    expand(os.path.join(config["outdir_qualimap"],"{sample}_{species}","qualimapReport.html") , sample=SIDs,species = species),
    expand(os.path.join(config["directories"]["qc"]["main"],"GCbias","{sample}_{species}", "gc_bias_metrics.txt"),sample=SIDs,species = species),
    expand(os.path.join(config["directories"]["qc"]["main"],"GCbias","{sample}_{species}", "gc_bias_metrics.pdf"),sample=SIDs,species = species),
    expand(os.path.join(config["directories"]["qc"]["main"],"GCbias","{sample}_{species}", "summary_metrics.txt"),sample=SIDs,species = species),
    expand(os.path.join(config["directories"]["bsmap"]["main"], "Filtered_bams", "{sample}_fixed_" + config["workflow"]["species"]["graft"] + "_Filtered.bam"), sample=SIDs),
    expand(os.path.join(config["directories"]["bsmap"]["main"], "Filtered_bams", "{sample}_fixed_" + config["workflow"]["species"]["graft"] + "_Filtered.bam.bai"), sample=SIDs),
    expand(os.path.join(config["outDir_mCall"], "{sample}_nsort.bismark.cov.gz"),sample = SIDs),
    expand(os.path.join(config["directories"]["bsmap"]["main"], "{sample}_nsort.bam"),sample =SIDs ),
    os.path.join(config["outDir_mCall"], "methrixh5","assays.h5"),
    os.path.join(config["outDir_mCall"], "methrixh5","se.rds"),
    os.path.join(config["outDir_mCall"], "methrixh5","bsseq.RDS"),
    os.path.join(config["directories"]["bsmap"]["main"], "bismark_summary_report.html"),
    os.path.join(config["qc_summary"],"qc_summary.txt")

# 第一次QC
include: "rules/01fastqcAtfirst.smk"

# Trim
include: "rules/02fastq2trim.smk"

# 第二次QC
include: "rules/03-0-fastqcAtclean.smk"

#seqkit
include: "rules/03-1-seqkit.smk"


# bsmap2sort

include: "rules/04bsmap2sort_bismark.smk"

# patch 4 PDX


# qualimap

include:"rules/05-3-qualimap.smk"

#Xenofilter

include:"rules/XenofilteR.smk"

# GCbias

include:"rules/collectGCbias.smk"

# build beta

include:"rules/pdx_build_methy_matrix_bismark.smk"

# bismark report

include:"rules/bismark_report2summary.smk"

# qc summary

include:"rules/bs_qc_summary.smk"

# methrix

include:"rules/methrix_object.smk"
