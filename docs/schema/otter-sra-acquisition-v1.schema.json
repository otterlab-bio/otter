{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otter.dev/schema/otter-sra-acquisition-v1.schema.json",
  "title": "Otter SRA Acquisition v1",
  "description": "Immutable, checksum-verified SRA archive and paired FASTQ provenance for production workflow inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "acquisition", "entries"],
  "properties": {
    "schema_version": {"const": "otter.sra-acquisition/v1"},
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "immutable", "root"],
      "properties": {
        "id": {"type": "string", "pattern": "^sra-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
        "created_at": {"type": "string", "format": "date-time"},
        "immutable": {"const": true},
        "root": {"type": "string", "pattern": "^/"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "md5": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "release", "manifest_sha256"],
      "properties": {
        "role": {"enum": ["primary", "graft", "host"]},
        "id": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fastq_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "paired_record_count"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "paired_record_count": {"type": "integer", "minimum": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "accession", "download", "output", "reference", "tool"],
      "properties": {
        "scenario": {"enum": ["rrbs", "wgbs", "rnaseq", "bs-pdx", "rna-pdx"]},
        "accession": {"type": "string", "pattern": "^SRR[0-9]+$"},
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "md5"],
          "properties": {
            "path": {"$ref": "#/$defs/absolute_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1},
            "md5": {"$ref": "#/$defs/md5"}
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["r1", "r2"],
          "properties": {
            "r1": {"$ref": "#/$defs/fastq_file"},
            "r2": {"$ref": "#/$defs/fastq_file"}
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {"$ref": "#/$defs/reference"},
            "species": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"$ref": "#/$defs/reference"}
            }
          },
          "oneOf": [
            {
              "required": ["primary"],
              "properties": {"species": false}
            },
            {
              "required": ["species"],
              "properties": {"primary": false}
            }
          ]
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "command"],
          "properties": {
            "name": {"const": "sra-tools"},
            "version": {"type": "string", "minLength": 1},
            "command": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"scenario": {"enum": ["bs-pdx", "rna-pdx"]}}},
          "then": {
            "properties": {
              "reference": {
                "required": ["species"],
                "properties": {
                  "species": {
                    "allOf": [
                      {"contains": {"properties": {"role": {"const": "graft"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"role": {"const": "host"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "reference": {
                "required": ["primary"],
                "properties": {
                  "primary": {
                    "properties": {"role": {"const": "primary"}},
                    "required": ["role"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
