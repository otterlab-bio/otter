{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otter.dev/schema/otter-sample-artifacts-validation-v1.schema.json",
  "title": "Otter Sample Artifact Validation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "workflow",
    "phase",
    "sample_id",
    "dimensions",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "otter.sample-artifacts-validation/v1"
    },
    "status": {
      "const": "validated"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object",
      "required": ["sample"],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "properties": {
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "species": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
