{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rainoffallingstar/otter/docs/schema/otter-config-v1.schema.json",
  "title": "Otter project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "workflow", "execution", "samples", "references"],
  "properties": {
    "schema_version": { "const": "otter.project/v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "description": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario"],
      "properties": {
        "scenario": { "enum": ["rrbs", "wgbs", "rnaseq", "bs-pdx", "rna-pdx"] },
        "toolchain": { "enum": ["modern", "legacy-equivalent"], "default": "modern" },
        "legacy_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["clubcpg", "mhap", "ccgg", "insert-length"] },
          "default": []
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executor": { "enum": ["craftmake", "snakemake"], "default": "craftmake" },
        "backend": { "enum": ["auto", "local", "slurm"], "default": "auto" },
        "site": { "type": "string", "minLength": 1, "default": "auto" }
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/referenceSelection" },
        "secondary": { "$ref": "#/$defs/referenceSelection" },
        "species": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "selection"],
            "properties": {
              "role": { "enum": ["primary", "secondary", "graft", "host"] },
              "selection": { "$ref": "#/$defs/referenceSelection" }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["primary"] },
        { "required": ["species"] }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": { "$ref": "#/$defs/resources" },
        "phases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/resources" }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": { "type": "boolean", "default": true },
        "retain_logs": { "type": "boolean", "default": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "scenario": { "enum": ["bs-pdx", "rna-pdx"] }
            },
            "required": ["scenario"]
          }
        }
      },
      "then": {
        "properties": {
          "references": {
            "required": ["species"],
            "not": { "required": ["primary"] },
            "properties": {
              "species": {
                "minItems": 2,
                "maxItems": 2,
                "allOf": [
                  { "contains": { "properties": { "role": { "const": "graft" } }, "required": ["role"] } },
                  { "contains": { "properties": { "role": { "const": "host" } }, "required": ["role"] } }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "referenceSelection": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cores": { "type": "integer", "minimum": 1 },
        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(MiB|GiB)$" },
        "time": { "type": "string", "pattern": "^[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]$" },
        "partition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
